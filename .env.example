# ===== 必填 =====
# 微信公众号 AppID / AppSecret（且公众号后台要把页面域名加入「JS 接口安全域名」）
WX_APP_ID=wxxxxxxxxxxxxxxxx
WX_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 允许被签名的页面域名，逗号分隔，支持 *.example.com
ALLOWED_HOSTS=m.example.com

# ===== 常用可选 =====
# 跨域来源默认取 ALLOWED_HOSTS（https://<域名>），一般不用填。
# 只有当调用方页面域名与可签名域名不一致时才显式列出完整 origin
ALLOWED_ORIGINS=

# 非空时调用签名接口必须带请求头 X-API-Key，多个用逗号分隔
# 生成：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEYS=

# 非空时开放 GET /admin/status（需请求头 X-Admin-Token），留空则该接口返回 404
ADMIN_TOKEN=

# ===== 运行参数 =====
NODE_ENV=production
PORT=3000
# 用 Nginx 反代时保持 127.0.0.1；若直接暴露公网改成 0.0.0.0（不推荐）
HOST=127.0.0.1
# 只信任本机 Nginx 传来的 X-Forwarded-For
TRUST_PROXY=loopback

# 本地联调 http 页面时可临时设为 false，线上必须 true
REQUIRE_HTTPS=true

# 凭证缓存文件（相对启动目录），重启后免去一次微信请求
CACHE_FILE=.cache/wx-credentials.json

# 启动预热 + 定时刷新凭证，让签名请求不依赖微信接口实时可用
PREWARM=true
REFRESH_INTERVAL_MS=1800000

WX_TIMEOUT_MS=8000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
